#!/usr/bin/env bash
# Production-source coverage, measured and gated exactly as CI does (W0.41).
#
#   bin/test-coverage                 the three workspaces CI measures
#   bin/test-coverage openehr-store   one of them
#
# For each workspace: nightly `cargo llvm-cov --lib --tests` writes LCOV, then
# `scripts/check-coverage.py` applies the exclusion register and the per-
# workspace floor in `coverage-floor.tsv`. The CI `coverage` job calls this
# same script, so a lowered test fails the same way in both places. This used
# to be `cargo tarpaulin` on `openehr` alone -- a different tool, a different
# line count, and no gate -- so a local pass said nothing about CI.
#
# Needs: rustup toolchain install nightly --component llvm-tools-preview
#        cargo install cargo-llvm-cov --locked
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

if [[ $# -gt 0 ]]; then workspaces=("$@"); else workspaces=(openehr openehr-store openehr-sqlite); fi

# `RUSTUP_TOOLCHAIN` outranks the checked-in rust-toolchain.toml; `rustup
# default` does not. RUSTFLAGS is empty on purpose: this measures, it does
# not lint, and nightly has lints the stable job does not.
export RUSTUP_TOOLCHAIN=nightly
export RUSTFLAGS=""
tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

failed=()
for w in "${workspaces[@]}"; do
  echo "== coverage ${w}"
  if ! ( cd "${w}" && cargo llvm-cov --lib --tests --lcov \
           --ignore-filename-regex '/\.cargo/registry/|/rustc/' \
           --output-path "${tmp}/${w}.lcov" ) \
     || ! python3 scripts/check-coverage.py --workspace "${w}" --lcov "${tmp}/${w}.lcov"; then
    echo "FAIL ${w}" >&2
    failed+=("${w}")
  fi
done
if [[ ${#failed[@]} -gt 0 ]]; then
  echo "coverage failed: ${failed[*]}" >&2
  exit 1
fi
echo "ok (${#workspaces[@]} workspaces)"
