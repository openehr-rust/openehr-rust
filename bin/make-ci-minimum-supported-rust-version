#!/usr/bin/env bash
# Check and test the repo on Rust N-2 (the MSRV) and N-1.
#
# The MSRV is read from the RM crate's manifest (RV2).
# N-1 is the next minor up. For each toolchain this runs, on every
# non-fuzz workspace, `cargo check --locked --all-targets` and
# `cargo test --locked` using cargo's explicit +toolchain selection.
# DB-gated tests stay skipped. Each toolchain must already be installed:
#   rustup toolchain install <version> --profile minimal
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

msrv="$(sed -nE 's/^rust-version = "(1\.[0-9]+)"$/\1/p' openehr/Cargo.toml)"
if [[ ! "${msrv}" =~ ^1\.([0-9]+)$ ]]; then
  echo "could not read rust-version from openehr/Cargo.toml" >&2
  exit 2
fi
n1="1.$(( BASH_REMATCH[1] + 1 ))"

# Each top-level manifest owns an independent workspace. Fuzz targets need nightly.
roots=()
for manifest in */Cargo.toml; do
  root="${manifest%/Cargo.toml}"
  [[ "${root}" == *-fuzz ]] || roots+=("${root}")
done
if [[ "${#roots[@]}" -ne 10 ]]; then
  echo "expected ten non-fuzz workspaces, found ${#roots[@]}" >&2
  exit 2
fi

# rustup distinguishes an installed minor alias from its installed patch release.
host="$(rustc -vV | sed -n 's/^host: //p')"
installed="$(rustup toolchain list)"
failed=0
for minor in "${msrv}" "${n1}"; do
  toolchain=""
  highest_patch=-1
  while read -r candidate _; do
    version="${candidate%-"${host}"}"
    [[ "${version}" != "${candidate}" ]] || continue
    if [[ "${version}" == "${minor}" ]]; then
      toolchain="${candidate}"
      break
    fi
    patch="${version#"${minor}."}"
    if [[ "${patch}" != "${version}" && "${patch}" =~ ^[0-9]+$ ]] && (( patch > highest_patch )); then
      toolchain="${candidate}"
      highest_patch="${patch}"
    fi
  done <<< "${installed}"
  if [[ -z "${toolchain}" ]]; then
    echo "missing Rust ${minor} for ${host}: rustup toolchain install ${minor} --profile minimal" >&2
    failed=1
    continue
  fi
  echo "==> Rust ${toolchain}"
  for root in "${roots[@]}"; do
    echo "--> ${root}"
    (cd "${root}" && cargo +"${toolchain}" check --locked --all-targets && cargo +"${toolchain}" test --locked) || failed=1
  done
done
exit "${failed}"
